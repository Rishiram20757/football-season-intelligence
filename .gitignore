# Compiled Python / bytecode
__pycache__/
*.py[cod]
*$py.class

# Jupyter notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints
.checkpoints/

# Virtual environments and local packages
.venv/
venv/
env/
ENV/

# Local secrets / credentials
.env
.env.*
*.secrets
.secrets/
credentials.json
service-account.json

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

